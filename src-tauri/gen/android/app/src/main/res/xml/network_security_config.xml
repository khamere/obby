<?xml version="1.0" encoding="utf-8"?>
<!-- A CA the user installs on the phone is trusted too, so a private server
     with its own CA reaches the app the way it reaches a browser. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
