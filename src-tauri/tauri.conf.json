{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Obby",
  "version": "../package.json",
  "identifier": "com.obsidianirc.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Obby",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https: wss: blob: data: ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://w.soundcloud.com; object-src 'self' https: blob:; base-uri 'self'; form-action 'self'; manifest-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "schemes": ["irc", "ircs"],
          "host": "*",
          "appLink": false
        },
        {
          "host": "obsidianirc.github.io",
          "pathPrefix": [
            "/"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "irc",
          "ircs"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/obsidianirc/obsidianirc/{{target}}-{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNDk5NjkzQzZDQ0Q0NDAKUldSQTFNekdrNVpKNGVINXY3ekZ4blo3ZFJMK0d6WGpzalZWVFNRTENRTU9DbFgzTW1FRkJkRkcK"
    }
  }
}
